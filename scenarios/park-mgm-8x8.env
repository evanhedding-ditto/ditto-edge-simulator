# Load test at Park MGM: eight real PX4s, each flyable from UAS Tool and each
# with its own camera feed, beside eight synthetic nodes; every vehicle has an
# Edge Server. px4_0..px4_7 are PX4 SIH, px4_8..px4_15 synthetic.
SIM_SCENARIO_ID=park-mgm-8x8
SIM_VEHICLE_COUNT=16
SIM_SYNTHETIC_VEHICLE_COUNT=8
SIM_SYNTHETIC_START_INDEX=8
SIM_ENABLE_CLOUD_SYNC=1
SIM_GCS_TCP_PORT=5760
SIM_RTSP_PORT=8554
SIM_PROCESS_COMPOSE_PORT=18089
SIM_NETWORK_LINK_CAPACITY_KBPS=10000
SIM_VIEWER=cesium-native
SIM_VIEWER_RADIUS_M=500
SIM_WORLD_FILE=worlds/park-mgm-1km.json
SIM_ISR_TARGETS_FILE=scenarios/park-mgm-isr-targets.json
PX4_HOME_LAT=36.1040361
PX4_HOME_LON=-115.1731679
PX4_HOME_ALT=650
