# Park MGM, using the opt-in Cesium Native raylib tile layer: one PX4 that a
# phone flies and watches over Wi-Fi. UAS Tool connects MAVLink over TCP to
# SIM_GCS_TCP_PORT + index on this Mac, and plays the drone's nose camera from
# rtsp://<this Mac>:SIM_RTSP_PORT/px4_<index>.
SIM_SCENARIO_ID=park-mgm-cesium
SIM_VEHICLE_COUNT=1
SIM_GCS_TCP_PORT=5760
SIM_RTSP_PORT=8554
SIM_PROCESS_COMPOSE_PORT=18087
SIM_NETWORK_LINK_CAPACITY_KBPS=10000
SIM_VIEWER=cesium-native
SIM_VIEWER_RADIUS_M=500
SIM_WORLD_FILE=worlds/park-mgm-1km.json
PX4_HOME_LAT=36.1040361
PX4_HOME_LON=-115.1731679
PX4_HOME_ALT=650
