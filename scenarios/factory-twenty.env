# Twenty factory robots in a three-level building, on the full Edge Server
# stack: relay, one Edge Server per robot, an operator server, one MAVLink
# adapter per robot, and the network observer.
#
# TIER 2, SYNTHETIC. Like the synthetic scenarios this proves Edge Server
# network operation, not software integration -- there is no PX4 here. What it
# adds over synthetic-twenty is a fleet whose positions mean something: robots
# are distributed over three floors and separated by walls, which is the
# geometry the network-restriction work needs in order to have anything to
# restrict.
#
# REPORT-ONLY. The robots drive their own patrol and discard the adapter's arm
# and offboard requests, so those commands time out by design and this scenario
# does not exercise the fleet-command path. Use a synthetic or mixed scenario
# for that.
SIM_SCENARIO_ID=factory-twenty
SIM_VEHICLE_COUNT=20
SIM_PROCESS_COMPOSE_PORT=18086
SIM_NETWORK_LINK_CAPACITY_KBPS=10000
SIM_MESH_PEERS_PER_VEHICLE=4
SIM_OPERATOR_MESH_PEERS=4
SIM_PROCESS_TEMPLATE=config/process-compose-factory.yaml.sh

# Synthetic TIER, factory FLEET. The first says how the autopilot tier is
# shaped -- one in-process fleet on the synthetic port layout, holding no Edge
# connection, with adapters dialling in -- which is exactly true here and is
# what every existing gate keys on (process/mavlink-adapter.sh's endpoint choice,
# session/wait-telemetry.sh skipping the PX4 boot phases, sim.sh building the adapter).
# The second only selects which fleet binary the process template starts.
SIM_SYNTHETIC_FLEET=1
SIM_FACTORY_FLEET=1

# The building. Read by BOTH the viewer, which draws it, and the factory fleet,
# which decides where a robot may drive -- the same file opened twice, never a
# channel between the two.
SIM_WORLD_FILE=worlds/factory-three-level.json

# Peer-to-peer discovery stays OFF, as in every scenario, and here it is
# load-bearing rather than incidental. Wall-based link restriction can only
# work while every peer connection traverses the simulator's relay. Turn `lan`
# on and robots find each other directly, the relay never sees it and neither
# do its metrics, and the walls become decoration that the viewer goes on
# drawing as though they worked. The config templates already default these
# off; this note is here so nobody switches them on for realism.
