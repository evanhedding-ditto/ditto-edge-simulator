# Twenty synthetic vehicles: the apples-to-apples comparison against
# mvp-twenty-mixed. Same vehicle count, same five-peer mesh, same Edge Servers
# and relay -- the only difference is that the autopilot and adapter tier is one
# kinematic process instead of 20 PX4 + 10 XRCE agents + 20 adapters.
SIM_SCENARIO_ID=synthetic-twenty
SIM_VEHICLE_COUNT=20
SIM_PROCESS_COMPOSE_PORT=18084
SIM_NETWORK_LINK_CAPACITY_KBPS=10000
SIM_MESH_PEERS_PER_VEHICLE=4
SIM_OPERATOR_MESH_PEERS=2
SIM_PROCESS_TEMPLATE=config/process-compose-synthetic.yaml.sh
SIM_SYNTHETIC_FLEET=1
