# One hundred synthetic vehicles. This is the scenario the synthetic publisher
# exists for: 100 Edge Servers in a five-peer mesh, which is the Edge Server
# scale target, on a machine that cannot run 100 PX4 SIH instances at all.
SIM_SCENARIO_ID=synthetic-hundred
SIM_VEHICLE_COUNT=100
SIM_PROCESS_COMPOSE_PORT=18085
SIM_NETWORK_LINK_CAPACITY_KBPS=10000
SIM_MESH_PEERS_PER_VEHICLE=5
SIM_OPERATOR_MESH_PEERS=5
SIM_PROCESS_TEMPLATE=config/process-compose-synthetic.yaml.sh
SIM_SYNTHETIC_FLEET=1
